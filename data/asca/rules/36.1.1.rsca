	o > a / C_w ,C:[+pharyngeal]} // C = {[+ cons, - fr, + bk, + hi, - lo]
	ŋ > n / n_Cʲa(ta)
	ŋ > ∅ / #_ // #_oʷ
	k > j / :{ e_, a_, o_ }:
	k > w / V_
	{ {o,a}, {a(ta),a(ch)} } > { e, a } / _ŋ
	{a(ta),a(ch)} > o
	? > o / _ŋ
	{[+affricate]ʲ,Fʲ}[+alveolar] > [+affricate], F / _?ʲ
	ʈ > ʈʂ / _r
	C > Cʲ / ?ʲ{p,t}_
	{p,t} > ∅ / V_
	o > a / Cʲ_w
	∅ > w / C_o# ,C:[+pharyngeal]} // C = {[+ cons, - fr, + bk, + hi, - lo]
	w > ∅ / C̣Cʲ_?w (optional)
	w > ∅ / w?_
	? > a / Cw_Cʲ
	{o,e} > ? / _Cʲ
