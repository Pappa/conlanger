	t͡ʃ > {t͡ʃ,t͡s} : t͡ɬ
	t͡ʃʼ > {sʼ,t͡ʃʼ} : t͡ɬʼ
	{ kʲ, kʲʼ } > { {k,ʃ}, kʼ }
