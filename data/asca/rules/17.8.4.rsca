	{ kʷ, kʰʷ, ɡʷ } > { p, pʰ, b } / :{ _a, _o, _C }:
	{ kʷ, kʰʷ, ɡʷ } > { k, kʰ, ɡ } / _u
	{ kʷ, kʰʷ, ɡʷ } > { k, kʰ, ɡ } / u_
	t͡s > s
