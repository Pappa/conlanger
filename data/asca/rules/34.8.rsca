@ 34.8 - Proto-Quechumaran to Santiago
# citation: Pogostick Man, from Orr, Carolyn, and Robert E. Longacre (1968), “Proto-Quechumaran”. Language 44(3):528 – 555
	{ pʼ, tʼ, t͡ʃʼ, kʼ, qʼ } > { p, t, t͡ʃ, k, q }
	h > ∅ / :{ p_, t_, k_ }:
	{k,q} > h / :{ _C, _# }:
	k > c / j_ (?)
	t͡s(h) > t͡ʃ
	t͡ʃ > ʃ / _q
	ʈʂ > ʃ / _[+ cons, - fr, + bk, + hi, - lo]
	ʈʂ > t͡ʃ / _V
	ɸ(ʼ,ʰ) > p
	ʃ > s // i_i or _S
	ʂ > ∅ / :{ _a, _i }:
	ʂ > h / _u
	h > ∅ / #_
	ʎ > ʒ / :{ _a, _u }:
	w > ∅ / V_V
	w > m / _%N
	j > ∅ / :{ i_a, i_u }:
	j > ∅ / u_ʎ