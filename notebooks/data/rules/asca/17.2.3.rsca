@ 17.2.3 - Common Anatolian to Lycian
# citation: Alces, from http://www.unc.edu/~melchert/anathistphon.pdf (link is dead)
	D > T / #_
	D > F:[+voice]
	N{F:[+voice],T} > nD
	d > k / _w
	kʷ > t / _E
	kʷ > k / _E, in Milyan
	{ɡ́,ɡ} > j / _{ e, e:[+ long] }
	{ɡ́,ɡ} > ∅ / _{ i, i:[+ long] }
	ɡ > ∅ / V_V
	j > ∅ / t͡s_
	s > z / _{R,j,w}
	s > h
	ḱ > s
	ɣʷ > ɡ / _B
	x > k / E_E (probably a palatal stop)
