	bʱ dʱ ɡ́ʱ > b d z
	ḱ ɡ́ > s z
	k(ʷ) ɡ(ʷ)(ʱ) > t͡ʃ d͡ʒ / _E
	k kʷ ɡ(ʷ)(ʱ) > x k ɡ / _ // _E
	rt > š
	s > {s,h}
	u̯ > v
	l > r
	{n̩,m̩} > a
	{l̩,r̩} > ər(ə(r))
	e e:[+ long] > a a:[+ long]
	o o:[+ long] > {a,a:[+ long]} a:[+ long]
	h(j) > ŋh / a_a
	hw > ŋʷh / a_a
