@ 37.1.1 - Proto-Iroquoian to Cherokee
# citation: cedh audmanh, from Julian, Charles (2010), “A History of the Iroquoian Languages”,
# 			University of Manitoba, Winnipeg
	k kʷ > t͡s k / _i
	w > ∅ / h_i
	w > ∅ / t(h)_
	{wV,jV} > V:[+ long, +low falling tone]
	V > ∅ / C_hC
	Vʔ > V:[+ long, +low falling tone] / _C
	{Vh,Vʔ} > V:[+ long] / _#
	{ a, a:[+ long] }wẽ(ː) > { a, a:[+ long] }m{ a, a:[+ long] }
	V:[+ nasal] > a:[+ long]:[+high rising tone]
	∅ > V:[+ long, +high rising tone] / C_# (“usually one of [/a:[+ long] i:[+ long] ʌ̃ː/ with this tone], the conditions
				are unclear”)
	iji > i:[+ long]
	t͡sn > hst
	n > h / _st
	{n,r} > ∅ / _j
	t > ∅ / _{k,n}
	t > ∅ / n_
	j > ∅ / t͡s_
	∅ > i / C_R
	s > ∅ / #h_V
	t͡s > s / h_
	ks > t͡s / _V
	nh > hn
	ẽ(ː) õ(ː) > { o, o:[+ long] } ʌ̃(ː)
	r > l
	t t͡s k kʷ > d dz ɡ ɡʷ / _V