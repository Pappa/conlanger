@ 37.1.1 - Proto-Iroquoian to Cherokee
# citation: cedh audmanh, from Julian, Charles (2010), “A History of the Iroquoian Languages”, University of Manitoba, Winnipeg
	k kʷ > ts k / _i
	w > ∅ / h_i
	w > ∅ / t(h)_
	{wV,jV} > V:[+ long, +low falling tone]
	V > ∅ / C_hC
	Vʔ > V:[+ long, +low falling tone] / _C
	{Vh,Vʔ} > V:[+ long] / _#
	a(ː)wẽ(ː) > a(ː)ma(ː)
	V:[+ nasal] > a:[+ long]:[+high rising tone]
	∅ > V:[+ long, +high rising tone] / C_# (“usually one of [/a:[+ long] i:[+ long] ʌ̃ː/ with this tone], the conditions are unclear”)
	iji > i:[+ long]
	tsn > hst
	n > h / _st
	{n,r} > ∅ / _j
	t > ∅ / _{k,n}
	t > ∅ / n_
	j > ∅ / ts_
	∅ > i / C_R
	s > ∅ / #h_V
	ts > s / h_
	ks > ts / _V
	nh > hn
