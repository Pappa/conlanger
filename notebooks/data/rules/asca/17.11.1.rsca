@ 17.11.1 - Proto-Slavic to Polish
# citation: Xiądz Faust, in http://pittmirg.ovh.org/inne/psc.pdf
# 			http://pittmirg.ovh.org/inne/psc.pdf, mainly citing Klemensewicz et al. (1955),
# 			“Gramatyka historyczna języka polskiego”, and Dubisz and Długosz-Kurczabowa (2003?),
# 			“Gramatyka historyczna języka polskiego”
	# NB: The original document heavily uses Slavistic notation as opposed to IPA; I’ve
	# 			done the best I could in figuring this stuff out but be warned of possible errors.
	sk x > ɕtɕ ɕ / _E
	x > ɕ / E_
	ɛl > lɔ / T_T “in certain cases (mostly after a PSl. palato-alveolar”)
	ɔl ɔr ɛl ɛr > lɔ rɔ lɛ rɛ / T_T
	ɔr ɔl > ra la / #_T “in syllables with long vowels”
	ɔr ɔl > rɔ lɔ / #_T
	C > Cʲ / _E // /j ɕ ʑ
	j > lʲ / {p,b,m,v}_
	ɛ ɛ̃ ɛ:[+ long] > ɔ ɔ̃ a / _C:[-palatalized +dental] (also sporadically before plain non-dentals)
	ɛ:[+ long] > ɛ
	# Havlik’s law:
	{ь,ъ} > e / iambic counting from U# or a syllable not containing a yer
	{ь,ъ} > ∅] / in even syllables counting iambic from U# or a syllable not containing a yer
	# — “[H]owever: in the vicinity of *j the development of yers did not comply with the
	# 			aforementioned law”
	ъ > a:[+ long] / _r
	ъl > ɔ(ː)ɫ / P_
	ъl > ɛɫ / [+ cons, - fr, + bk, + hi, - lo]_
	ъl > ɫu / _ // [+ cons, - fr, + bk, + hi, - lo]_
	ьl > ɫu / C:[+dental]_
	ьl > ɛɫ / P_C:[+dental -palatalized]
	ьl > il / P_
	ьl > ɔ(ː)ɫ
	ь > a:[+ long] / r_C:[+dental -palatalized]
	ьr > { i, i:[+ long] }ʐ
	{ i, i:[+ long] }ʐ > {ɛ(ː)r,ɛ(ː)ʐ}
	{ɛ(ː)r,ɛ(ː)ʐ} > {ɛr,ɛʐ}
	{ɛ̃,ɔ̃} > ã
	a ɛ i ɔ u ɨ ã > a:[+ long] ɛ:[+ long] i:[+ long] ɔ:[+ long] u:[+ long] ɨ:[+ long] ã:[+ long] / _{C/U}:[+ voice][lost yer] (i.e., a voiced consonant or a cluster with one)
	ajɛ > ɛ:[+ long] in adjectives, a:[+ long] in verbs
	{aja,ɔja} {ɔjɛ,ɨjɛ} ɨjɛ > a:[+ long] ɛ:[+ long] i:[+ long]
	{ɛ(ː)jɛ,ьjɛ,ɔjɛ,ujɛ,ɨjɛ} > ɛ:[+ long]
	{ɔjɔ̃,ɔ̃jɔ̃,ьjɔ̃} > ɔ̃ː
	ьjь ъjь > i ɨ
	jь > i / utterance-initially (cf. English utterance-initial glottal stops before vowels)
	ь ъ > i ɨ / _j
	ji > i / #_
	{aja,ɛja,ьja,ɔja} > a:[+ long]
	iji ɨjɨ > i ɨ
	ɔvi > ∅
	O:[+voice] > O:[-voice] / _# (unless followed by some type of voiced consonant, be it any type of consonant
				or just an obstruent—this differs by location)
	ɔ > ɔ:[+ long] / _{r,l}
	∅ > h / _ъ
	# Mobile stress > initial stress > penultimate stress (in most areas)
	V > ∅ / [- stress]
	i > ∅ / _# “in the infinite and imperative desinences. . .some verbs have never been
				affected due to a potential ‘difficult’ cluster that would result, instead they got
				an analogical final -j extension”
	t͡si ʐi > tɕ ʐ / V_
	i u > u i / {lʲ,j}_
	tʲ dʲ sʲ zʲ nʲ rʲ l lʲ > tɕ d͡ʒ ɕ ʑ ȵ r ɫ l (this last probably not before /i/)
	i:[+ long] u:[+ long] ɨ:[+ long] > i u ɨ
	ã > ɛ̃ / short only
	ã:[+ long] > ã
	ã > ɔ̃
	a:[+ long] ɔ:[+ long] ɛ:[+ long] > ɒ o e
	V:[+ long] > V in certain frequently-used words
	# Sporadic (de)nasalization of vowels; “there were certain environments which
	# 			favoured nasality changes: in the vicinity of nasal consonants. . .and before sibilants”
	{i,ɨ} > ɛ / _C:[+rhotic]
	k ɡ > kʲ ɡʲ / _ɛ where the vowel is from a yer or a borrowing
	kɨ ɡɨ > kʲi ɡʲi
	ʃi ʒi t͡ʃi d͡ʒi ɕi ʑi > ʂɨ ʐɨ ʈʂɨ ɖʐɨ t͡sɨ ʒɨ
	ʃ ʒ t͡ʃ d͡ʒ ɕ ʑ > ʂ ʐ ʈʂ ɖʐ t͡s ʒ
	r̝ > ʂ / C:[- voice]_
	r̝ > ʂ / _C:[+ voice]
	ŕ > ʐ / _ // _C:[+ voice]
	ɛ > ɔ / _ɫ (if the vowel was from a yer)
	{ɛ,a} > ɔ
	V > ɛ
	ɫ > w
	ɒ e > a ɛ
	o > ɔ / _N
	o > u / _ // _N
	u > ɔ
	pʲ mʲ fʲ > p m f / _#
	{i,ɨ} > ∅ / _jV when unstressed
	ɛ̃ > ɛ / _{#,l,ɫ}
	ɔ̃ > ɔ / _{l,ɫ}
	ɔ̃ > ɔ / _#
	ɛ̃ ɔ̃ > ɛ̃N ɔ̃N / _{S,A}
	ɛ̃ ɔ̃ > ɛɰ̃ ɔɰ̃ / _F:[-palatal]
	ɔ̃ > ɔɰ̃ / _#
	ɛ̃ ɔ̃ > ɛj̃ ɔj̃ / _F:[+palatal]
	ȵ > j̃ / _F
	n > ŋ / _S:[+velar]
	Cʲ > C / _C:[+dental]
	Cʲ > C
	Cʲ > C
	t > r / tV_
	n > m / {b,p}{l,r,ʐ}V_
	j > ∅ / _ɛ
	OR > RO / V_C
	RO > OR / C_V
	vC > Cv / _V
	Cv > vC / _C
	tɕt͡s ʑr̝ > jts jr̝
	ɕtɕ > js / _{t͜s,s}
	zʐ > ʐɖʐ
	ʑ z > dʑ dz / _v
	∅ > d / r_z
	v r̝ > f r̥ / C:[- voice]_
	v r̝ > f r̥ / _{C:[- voice],#}
	r̝̊ r̝ > ʂ ʐ
	Lv > L:[- voice]f / O:[- voice]_
	v > ∅ / x_o
	{xv,pv} > f
	plv > pf
	p > ∅ / #_p
	ʈʂs > t͡s
	{z,s,ʂ} > ∅ / _sC
	x > ∅ / _r
	r̝ > r / {ɕ,ʑ}_
	ʐr > ʑr
	ɕr̝ ʑr̝ > ʂr ʐr
	t > ∅ / s_{ɫ,w}
	ʈʂ > t / _r̝
	ɕ > ∅ / tr̝_tɕ
	ɡ > ∅ / _d
	w > ∅ / {r,b}_
	d > ∅ / ɫ_ɲ
	d > ∅ / r_t͡s
	d > ∅ / _n
	∅ > t / s_r
	st ʂʈʂ > z ʐ / _b
	{b,p} > ∅ / _n
	v > ∅ / _stv
	t > ∅ / ʈʂ_v
	s > ∅ / _ɫza
	trk > kr
	zdʲ stʲ > {ʑ,ɕ} {s,ɕ} / _n
	dʲ > ∅ / r_n
	stʲ > ɕ / _l
	slʲ > ∅ / _s
	pv > f
	ʈʂ > ʂ / _p
	stʲkl > ɕtɕkl
	ɕtɕkl > {ɕ,s}kɫ
	{ɕ,s}kɫ > ʂkɫ
	dz t͡s > d͜z t͜s
#	C:[+sibilant]P > C:[+alveolopalatal] / _C:[+coronal]
#	C:[+sibilant]P > C:[+dental]
	w > ∅ / C_#
	w > ∅ / C_C
	n > s
	s > ɕ / k_ɛ̃
	n > s / k_Vn
	d > ɡ / _n
	ʈʂ > t / _r
	ɕ > ∅ / t_ɕtɕ
	Pʲ > P / _C
	rʲ > r / _{s,t͜s,l,w,n,ɲ}
	tʲ dʲ > t d / _{l,n,ɲ,r,ʐ}
	ɕ ʑ > s z / _C