	a > i / {ŋ,w}_%
	a > wɤ / {K,ŋ}w_%
	{a,i} > ɯ / R_%
	a > ie / ! K_%
	a aS > ɑ {ɑ,u}
	iN > æ / {P,C}r_%
	i > v̩ / m_%
	u o > v̩ u
	B > o / {qʰ,(N)q}_
	V% > low tone
