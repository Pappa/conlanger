@ 37.1.2.2.1 - Huron to Wyandot
# citation: cedh audmanh, from Julian, Charles (2010), “A History of the Iroquoian Languages”, University of Manitoba, Winnipeg
	V:[+long] > ”V / in #; this change may have been present in Huron already
	t > k / _j
	xʷ > w
	{ʔ,h} > ∅ / _nh
	n > t / _h
	h > ∅ / :{ t_, t͡s_, s_, k_ }:
	Vh > V:[+long] / _R
	∅ > w / {{ o, o:[+long] }{ ,õ, ,õ:[+long] }}_V
	∅ > j / {{ e, e:[+long] }{ ,ẽ, ,ẽ:[+long] }{ ,i, ,i:[+long] }}_V
	x > ∅ / :{ _i, _j }:
	x > e / #_r
	{ w, j } > { m, ɲ } / between two vowels of unlike nasality
	j > ʒ / :{ #_V, ʔ_V, V_V }:
	x > j / _V
	x > ∅
	k > ∅ / _#
	{ {, ẽ,, ẽ:[+long], }, {, õ,, õ:[+long], }, {, o,, o:[+long], } } > { {, ɛ̃,, ɛ̃:[+long], }, {, ɔ̃,, ɔ̃:[+long], }, {, u,, u:[+long], } }
	n > ⁿd / :{ _V:[-nas], _r }:
	n > ŋ / :{ _j, _w }:
	{ ɛ̃, ɛ̃:[+long] } > { ã, ã:[+long] } / w_