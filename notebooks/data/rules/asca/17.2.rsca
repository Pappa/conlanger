	eh > æ:[+long] / tautosyllabic
	{ ei, eu } > { ɛ:[+long], u:[+long] }
	Dʱ > D
	H > R / VR_V
	h > ∅
	h > ∅
	{ T, h } > { D, h } / _#
	{ T, h } > { D, h } / V:[-stress]_V:[-stress]
	{ T, h } > { D, h } / V:[+long]
