	# Initials:
	bʱ {tʰ,dʱ} {t*ʰ,d*ʱ} {kʰ,ɡʱ} > pʰ t tʰ kʰ (after *kʰ *ɡʱ, only first-register tones may occur)
	(h)ə{p,b} (h)ə{t,d} (h)ə{c,ɟ} (h)ə{k,ɡ} > β dʲ ɟ ɡ
	{pj,bj} {tj,dj} {cj,ɟj} > {β,w} dʲ ɟ
	ɓ ɗ > m n
#	{n̥j,nj,ɲ̊j,ɲj} > ɲ
	t͡ʃ > Ω
	N:[- voice] W:[- voice] > N:[+ voice] W:[+ voice]
	((h)ə)p d > b t / _l
	t > ∅ / _ɹ
	t*ʰ d ɡ > tʰ t k / _w
	s > t(ʰ?)
	{əkʰ,əɡɦj} > ɟ
	# Finals:
	l > ∅ / {i,e}_
	l > j / _ // {i,e}_
	c ɲ > t n / ! E_
	a ɔ > ɨə uə