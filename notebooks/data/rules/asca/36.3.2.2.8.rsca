	# Initials:
	pr b > br p
	d [+ cons, - fr, + bk, + hi, - lo]T > l kt
	k kr kj ɡ > k. k.r ts. ɡ
	ɡ ç > ∅ zɡ / _r
	Pç çl > ʃ ʃn
	ts dzl NTS > {tʃ.,j} tsl m
	s > ʃ / _n
	ŋ > j
	Nnj çnj > mn ʃn
	# Rhymes:
	uk > o
	o > ə / _n
	t > ∅ / a_
