@ 23.1.1.1.2 - Proto-Chibchan to Chibcha
# citation: Pogostick Man, from Wheeler, Alva (1972), “Proto-Chibchan”. In Matteson, Esther, ed.,
# 			Comparative Studies in Amerindian Languages 93 – 108
	b > p / _Vkʷ
	Vs > h / n_
	V > ∅ / s_j
	s > h / V_V
	t͡s > {s,z}
	w > {w,∅}
	j > ∅
	n > {n,∅}
	a > ∅ / _i, when unstressed
	a > i / _Ci
	a > ∅ / _u
	u > o / _Ca
	u > ∅ / _a
	i > u / _(C)u
	i > a / _(C)a
	i > e / _(C)e
	a {e,i} > i ∅ / C”V(C)_
	i > ∅ / _(C)”V
	a > ∅ / _”V