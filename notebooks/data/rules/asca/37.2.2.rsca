	p > p
	p > b
	p > m
	p > w
	tʲ > ʃ / in ”U
	tʲ > ʒ / else
	s > z / in U:[-stress]
	s > z / V_V
	r > d / s_
	tʲr > st
	tʲr > ʃt
	r > d / x_
	mn > mVnV / #_
	km > kVmV
	w > p / _t
	t > ∅ / _k, when medial
