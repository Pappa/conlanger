@ 12.1.2 - Proto-Abazgi to Tapanta Abaza
# citation: Nortaneous, from Chirikba, Viacheslav A. (2003), “Abkhaz”. Languages of the World/Materials 119.
	{ {t͡ʃʷʼ,t͡ɕ}, {d͡ʒʷ,d͡ʑ} } > { t͡sʼ, d͡z }
	{ t͡ɕʷʼ, d͡ʑʷ } > { {t͡ɕʷʼ,t͡ʃʷʼ}, {d͡ʑʷ,d͡ʒʷ} }
	{ ɕ, ʑ } > { s, z }
	{ ʃʷ, ʒʷ, ɕʷ, ʑʷ } > { {ɕʷ,ʃʷ}, {ʑʷ,ʒʷ}, {ɕʷ,ʃʷ}, {ʑʷ,ʒʷ} }
	{tʷʼ,dʷ} > {t͡ɕʷʼ,t͡ʃʷʼ} {d͡ʒʷ,d͡ʑʷ}