@ 46.7 - Great Vowel Shift (English)
# citation: Jaaaaaa and Ran, citing http://www.peak.org/~jeremy/dictionary/chapters/history.php
	{ i:[+long], u:[+long] } > { əj, əw }
	{ əj, əw } > { ɑj, ɑw }
	{ e:[+long], o:[+long] } > { i:[+long], u:[+long] }
	ɛ:[+long] > e:[+long]
	e:[+long] > i:[+long]
	{ a:[+long], ɔ:[+long] } > { ɛ:[+long], o:[+long] }
	{ ɛ:[+long], o:[+long] } > { e:[+long], ow }
	{ e:[+long], ow } > { ej, (əw) }