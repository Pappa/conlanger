	VN VC:[-nas] > V:[+nas] V:[+long] / _#
	a{i,j}(a) a{u,w}(a) > e o
	j w > d͡ʒ b / V_V
	C > C:[+voice] / V_V
	{bʱ,dʱ,ɡʱ} {j,v} > h ∅ / V_V
	b {d,d͡ʒ,ɡ} > v j / V_V
	Vm > Vv / _V
	Vv > V:[+nas]v / _V
	e o > i u / _#
	V:[+long] > V:[-long] / _#
	ah > e
	ɽ > i
	kʂ > hk
	ʂ s > s ç
	r > l
	v > ∅ / {t,d}_
	CC > CC / V_V
